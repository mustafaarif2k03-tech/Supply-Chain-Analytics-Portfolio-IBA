      "source": [
        "## 11. Vendor Pareto Analysis - 80/20 Rule\n",
        "\n",
        "I will perform a Pareto analysis to identify which vendors contribute to approximately 80% of the total procurement spend. This analysis helps in understanding the concentration of spend and identifying key suppliers."
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 1000
        },
        "id": "f037d36b",
        "outputId": "94474271-2efd-433a-c014-f1aea3b0e028"
      },
      "source": [
        "# Calculate total spend per vendor\n",
        "vendor_spend = df.groupby('Vendor')['PO Value (PKR)'].sum().reset_index()\n",
        "vendor_spend.columns = ['Vendor', 'Total Spend (PKR)']\n",
        "\n",
        "# Sort vendors by spend in descending order\n",
        "vendor_spend = vendor_spend.sort_values(by='Total Spend (PKR)', ascending=False)\n",
        "\n",
        "# Calculate cumulative spend and cumulative percentage\n",
        "vendor_spend['Cumulative Spend (PKR)'] = vendor_spend['Total Spend (PKR)'].cumsum()\n",
        "vendor_spend['Cumulative Percentage'] = (vendor_spend['Cumulative Spend (PKR)'] / vendor_spend['Total Spend (PKR)'].sum()) * 100\n",
        "\n",
        "# Identify vendors contributing to 80% of the total spend\n",
        "pareto_vendors = vendor_spend[vendor_spend['Cumulative Percentage'] <= 80]\n",
        "\n",
        "print(\"\\n--- Vendor Pareto Analysis (80/20 Rule) ---\")\n",
        "display(pareto_vendors)\n",
        "\n",
        "# Visualization for Pareto Analysis\n",
        "fig, ax1 = plt.subplots(figsize=(14, 8))\n",
        "\n",
        "sns.barplot(x='Vendor', y='Total Spend (PKR)', data=vendor_spend, palette='viridis', ax=ax1)\n",
        "ax1.set_xlabel('Vendor', fontsize=12)\n",
        "ax1.set_ylabel('Total Spend (PKR)', color='blue', fontsize=12)\n",
        "ax1.tick_params(axis='y', labelcolor='blue')\n",
        "plt.xticks(rotation=90, ha='right')\n",
        "\n",
        "ax2 = ax1.twinx()\n",
        "ax2.plot(vendor_spend['Vendor'], vendor_spend['Cumulative Percentage'], color='red', marker='o', linestyle='-')\n",
        "ax2.set_ylabel('Cumulative Percentage (%)', color='red', fontsize=12)\n",
        "ax2.tick_params(axis='y', labelcolor='red')\n",
        "ax2.axhline(y=80, color='gray', linestyle='--', label='80% Threshold')\n",
        "ax2.legend(loc='center right')\n",
        "\n",
        "plt.title('Vendor Pareto Analysis: Total Spend and Cumulative Percentage', fontsize=16)\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ],
